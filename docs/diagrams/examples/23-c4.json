    { "id": "deployment", "diagram": "c4.deployment", "title": "Bookshop: production deployment", "parent": "context",
      "nodeIds": ["device", "browser", "storefront-1", "web-host", "docker", "api-1", "worker-1", "db-host", "postgres", "db-1", "queue-1"] }
  ]
}
