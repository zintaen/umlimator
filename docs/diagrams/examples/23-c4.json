    { "id": "c4-browser", "type": "c4.DeploymentNode", "label": "Web browser", "parent": "c4-device", "props": { "technology": "Chrome, Firefox, Safari or Edge" } },
    { "id": "c4-storefront-1", "type": "c4.ContainerInstance", "label": "Storefront", "parent": "c4-browser", "props": { "container": "c4-storefront" } },
    { "id": "c4-web-host", "type": "c4.DeploymentNode", "label": "Web server", "props": { "technology": "Ubuntu 24.04 LTS", "description": "The web tier's server." } },
    { "id": "c4-docker", "type": "c4.DeploymentNode", "label": "Docker Compose", "parent": "c4-web-host", "props": { "technology": "Docker Engine 27" } },
    { "id": "c4-api-1", "type": "c4.ContainerInstance", "label": "Shop API", "parent": "c4-docker", "props": { "container": "c4-api" } },
    { "id": "c4-worker-1", "type": "c4.ContainerInstance", "label": "Order worker", "parent": "c4-docker", "props": { "container": "c4-worker" } },
    { "id": "c4-db-host", "type": "c4.DeploymentNode", "label": "Database server", "props": { "technology": "Ubuntu 24.04 LTS", "description": "Backed up every night." } },
