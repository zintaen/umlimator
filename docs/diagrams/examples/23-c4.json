{
  "schemaVersion": 2,
  "title": "Bookshop: architecture in C4",
  "root": "c4-context",
  "nodes": [
    { "id": "c4-shopper", "type": "c4.Person", "label": "Shopper", "props": { "description": "Browses the catalogue, buys books and tracks orders." } },
    { "id": "c4-staff", "type": "c4.Person", "label": "Shop staff", "props": { "description": "Keep the catalogue up to date and refund orders." } },
    { "id": "c4-bookshop", "type": "c4.SoftwareSystem", "label": "Bookshop", "opensView": "c4-containers",
      "props": { "description": "Sells books online: catalogue, basket, checkout and order tracking." } },
    { "id": "c4-payments", "type": "c4.SoftwareSystem", "label": "Payment provider", "props": { "description": "Takes card payments and makes refunds.", "external": true } },
    { "id": "c4-mail", "type": "c4.SoftwareSystem", "label": "Email service", "props": { "description": "Delivers the shop's emails.", "external": true } },
    { "id": "c4-courier", "type": "c4.SoftwareSystem", "label": "Courier", "props": { "description": "Collects parcels and delivers them to shoppers.", "external": true } },
