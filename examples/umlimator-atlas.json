{
 "$schema": "../lib/umlimator.schema.json",
 "schemaVersion": 2,
 "title": "Umlimator Atlas",
 "root": "overview",
 "nodes": [
  {
   "id": "author",
   "label": "Author",
   "kind": "person",
   "sublabel": "writes a model",
   "what": "Whoever draws a system: a person in an editor, or an assistant on their behalf.",
   "how": "Writes a model as JSON (nodes, edges, views), checks it with `umlimator.py check`, and shares the page it renders.",
   "icon": "users"
  },
  {
   "id": "assistant",
   "label": "AI assistant",
   "kind": "agent",
   "sublabel": "an MCP client",
   "what": "An AI assistant that reads a model and shows its reader what it means.",
   "how": "Calls the MCP server's read tools (`describe`, `paths`, `reach`) and its page tools (`show_view`, `highlight`, `tour`, `play_story`)."
  },
  {
   "id": "skill",
   "label": "map-repo skill",
   "kind": "skill",
   "sublabel": "plugins/umlimator",
   "what": "An agent skill that maps a repository: it reads the code and writes a model of it.",
   "how": "Its SKILL.md tells the assistant how to find the parts and their lines, write the model and check it with the CLI."
  },
  {
   "id": "model-file",
   "label": "Model JSON",
   "kind": "file",
   "sublabel": "nodes, edges, views",
   "what": "One file holds the whole map: cards, lines, the views that show them, stories, lenses and rules.",
   "how": "Schema version 2 adds typed views (`diagram`), each drawn by its type; lib/umlimator.schema.json describes every field."
  },
  {
   "id": "readers",
   "label": "Readers",
   "kind": "module",
   "sublabel": "what umlimator.py import reads",
   "what": "The importers: a diagram written in another notation, read into a model.",
   "how": "`umlimator.py import` runs them in Node for Structurizr JSON, DBML, BPMN XML, Mermaid's class, sequence, state, ER, requirement and mindmap diagrams, and a Mermaid flowchart given --typed. Structurizr DSL, C4-PlantUML, Compose, Kubernetes and Mermaid's flowcharts and C4 diagrams it reads into a map in Python (umlimator_import.py), with no Node."
  },
  {
   "id": "cli",
   "label": "umlimator.py",
   "kind": "cli",
   "sublabel": "render, check, pdf, diff",
   "what": "The command line: one Python file, standard library only.",
   "how": "Renders a page, checks its layout and draws stills and PDFs in headless Chrome; diff, drift, trace and timelapse run the module's functions in Node.",
   "opensView": "context"
  },
  {
   "id": "module",
   "label": "The module",
   "kind": "module",
   "sublabel": "lib/umlimator.js",
   "what": "The core: `render()`, `layout()`, `validate()`, `check()`, `diff()` and the map's canvas, in one file with no dependency.",
   "how": "Built from src/ by tools/build.mjs. Its layers are the views list's package diagram; double-click for it.",
   "opensView": "layers"
  },
  {
   "id": "typed",
   "label": "umlimator/all",
   "kind": "module",
   "sublabel": "28 typed diagrams",
   "what": "The module with every typed diagram: UML, SysML, C4, ER, flowchart, data flow, BPMN, mindmap and three clouds.",
   "how": "Each type registers its layout, drawing, rules and editing with the core's registry. Double-click for the families.",
   "opensView": "registry",
   "opensCount": 9
  },
  {
   "id": "host",
   "label": "Host page",
   "kind": "frontend",
   "sublabel": "render(element, model)",
   "what": "A web page that embeds a map with `render()` and drives it through its handle.",
   "how": "The handle's machines (navigation, the story player, tours) report every change as one `MapState`. Double-click for them.",
   "opensView": "machines"
  },
  {
   "id": "element",
   "label": "<umlimator-map>",
   "kind": "frontend",
   "sublabel": "lib/umlimator-element.js",
   "what": "A custom element: a map from HTML alone, its still shown until the map is drawn.",
   "how": "Loads its `src` or the model written inside it, and draws it with `render()`."
  },
  {
   "id": "docs",
   "label": "Docs site",
   "kind": "frontend",
   "sublabel": "VitePress, docs/",
   "what": "The guide, the API and the conformance notes, published with this gallery.",
   "how": "A fenced `umlimator` block becomes a `<umlimator-map>` through umlimator/markdown-it."
  },
  {
   "id": "action",
   "label": "Diff Action",
   "kind": "hook",
   "sublabel": "action.yml",
   "what": "A GitHub Action: what a pull request changes in its map models, posted on the pull request.",
   "how": "Runs `umlimator.py diff --base`, uploads the pages and stills, and writes one comment. Double-click for its sequence.",
   "opensView": "diff-run",
   "opensCount": 5
  },
  {
   "id": "github",
   "label": "GitHub",
   "kind": "external",
   "sublabel": "pull requests",
   "what": "Where the code lives: a pull request starts the diff Action, and shows its comment.",
   "how": "The Action's token posts the comment; a fork's read-only token gets the job summary instead."
  },
  {
   "id": "chrome",
   "label": "Chrome",
   "kind": "external",
   "sublabel": "headless",
   "what": "Google Chrome or Chromium, which the CLI drives to draw what a page shows.",
   "how": "`stills`, `pdf`, `record` and `check` open the rendered page headless and read it back."
  },
  {
   "id": "page",
   "label": "The page",
   "kind": "frontend",
   "icon": "window",
   "sublabel": "mountPage(): keys, link",
   "opensView": "keys",
   "what": "The standalone page around the map, `mountPage()`: breadcrumbs, search, menus, the details panel and the story recorder.",
   "how": "One key router reads each key from the top open layer down. One function writes the link from what the map shows, and another follows a link, on load and on Back or Forward."
  },
  {
   "id": "mcp",
   "label": "MCP page",
   "kind": "ai",
   "icon": "bot",
   "sublabel": "umlimator.py mcp",
   "opensView": "mcp",
   "what": "The page `umlimator.py mcp` serves, which an AI assistant drives with its page tools: `show_view`, `highlight`, `tour`, `play_story` and `clear`.",
   "how": "The server folds the assistant's commands into what the page should show, and sends that. The page shows it on the map's handle and posts its `MapState` back, which `page_state()` returns."
  },
  {
   "id": "navigation",
   "label": "Navigation",
   "kind": "backend",
   "icon": "network",
   "sublabel": "setView(): latest wins",
   "opensView": "navigation",
   "what": "A move from one view to another: `setView()`, a drill-down, up, a story's step, or a link.",
   "how": "One move at a time. A request during a move takes it to its own view, and every request's promise says whether its view was shown."
  },
  {
   "id": "story",
   "label": "Story player",
   "kind": "backend",
   "icon": "flag",
   "sublabel": "play(): step by step",
   "opensView": "story",
   "what": "A story told step by step: `play()`, the page's Stories menu, or a link's `story=` and `step=`.",
   "how": "`player.state` is entering, playing or paused, then ended or stopped. A `story` event comes on each change. A move or a selection the story didn't make pauses it."
  },
  {
   "id": "tour",
   "label": "Tour and replay",
   "kind": "backend",
   "icon": "retry",
   "sublabel": "a dot that rides",
   "opensView": "tour",
   "what": "One trip at a time: `tour()`, `replay()`, or a story step's tour.",
   "how": "Its promise is true when the dot reaches the end, and false when the trip is cut short."
  },
  {
   "id": "mapstate",
   "label": "MapState",
   "kind": "database",
   "icon": "state",
   "sublabel": "handle.state, state event",
   "what": "The map's state as one snapshot: fresh, frozen and plain JSON on every read. The `state` event says which of its keys changed.",
   "how": "`handle.state`, the page's `window.umlimatorMap.state`, `<umlimator-map>`'s `el.map.state`, and the MCP tool `page_state()`."
  },
  {
   "id": "nav-rest",
   "label": "At rest",
   "kind": "state",
   "sublabel": "navigating: null",
   "what": "A view is shown and no move is under way."
  },
  {
   "id": "nav-leaving",
   "label": "Leaving",
   "kind": "state",
   "sublabel": "into the card or out",
   "what": "The camera zooms into the card that opens the view, or out, and the view fades (130 ms). Skipped under reduced motion."
  },
  {
   "id": "nav-drawing",
   "label": "Drawing",
   "kind": "state",
   "sublabel": "the latest target",
   "what": "The view asked for last is drawn, and the selection is cleared (a `select` event with `null`)."
  },
  {
   "id": "nav-entering",
   "label": "Entering",
   "kind": "state",
   "sublabel": "zoom to fit",
   "what": "The camera zooms to fit the new view. A press on the map settles the glide, and the move goes on."
  },
  {
   "id": "st-none",
   "label": "No story",
   "kind": "state",
   "sublabel": "handle.story: null",
   "what": "`handle.story` is `null`. `play()` of a story the model lacks returns `null` and leaves the story shown."
  },
  {
   "id": "st-entering",
   "label": "Entering a step",
   "kind": "state",
   "sublabel": "view, camera, highlight",
   "what": "The step's view, camera, selection and highlight are on their way. The `story` event comes first."
  },
  {
   "id": "st-playing",
   "label": "Playing",
   "kind": "state",
   "sublabel": "next step on its own",
   "what": "The next step comes once this one's time is up (4 s unless the step says) and its tour has ended."
  },
  {
   "id": "st-paused",
   "label": "Paused",
   "kind": "state",
   "icon": "pause",
   "sublabel": "its tour held too",
   "what": "`pause()`, ❚❚ on the bar, or the reader taking the map: a press, a wheel that zooms, a key, a view or a selection the story didn't make."
  },
  {
   "id": "st-ended",
   "label": "Ended",
   "kind": "external",
   "icon": "checks",
   "sublabel": "done: true",
   "what": "Past the last step: `next()`, ✓ on the bar, or the last step's time. `player.done` resolves `true`."
  },
  {
   "id": "st-stopped",
   "label": "Stopped",
   "kind": "external",
   "icon": "eyeoff",
   "sublabel": "done: false",
   "what": "`stop()`, ✕, Esc, `play(null)`, another `play()`, an `update()` whose model lacks the story, or `destroy()`. `player.done` resolves `false`."
  },
  {
   "id": "tr-none",
   "label": "No trip",
   "kind": "state",
   "sublabel": "state.tour: false",
   "what": "No dot rides. `tour()` and `replay()` start one; a new one ends the one before."
  },
  {
   "id": "tr-riding",
   "label": "Riding",
   "kind": "state",
   "sublabel": "state.tour: true",
   "what": "The dot rides the line between each pair of cards in turn, and each card it reaches flashes."
  },
  {
   "id": "tr-held",
   "label": "Held",
   "kind": "state",
   "icon": "pause",
   "sublabel": "where it is",
   "what": "The page's ❚❚, a paused story (for its step's tour), or the replay's `pause()`."
  },
  {
   "id": "tr-end",
   "label": "Reached the end",
   "kind": "external",
   "icon": "checks",
   "sublabel": "resolves true",
   "what": "`tour()` resolves `true`, and so does a replay's `done`; a replay's labels stay."
  },
  {
   "id": "tr-cut",
   "label": "Cut short",
   "kind": "external",
   "icon": "eyeoff",
   "sublabel": "resolves false",
   "what": "Esc on the map, `tour(null)`, the next tour or replay, a new picture of the view, the replay's `stop()`, or `destroy()`."
  },
  {
   "id": "tr-rest",
   "label": "Lit at rest",
   "kind": "state",
   "sublabel": "the path lit and said",
   "what": "Under reduced motion no dot rides: the path is lit in the `tour` layer and said, and `tour()` resolves `true` at once. It stays until Esc, `tour(null)`, the next trip or a new picture."
  },
  {
   "id": "ky-lightbox",
   "label": "An example, full size",
   "kind": "state",
   "sublabel": "holds every key",
   "what": "An example shown full size, from a thumbnail in the details panel. It holds every key while open; Esc closes it and focus goes back to the thumbnail."
  },
  {
   "id": "ky-search",
   "label": "Search",
   "kind": "state",
   "sublabel": "/ or ⌘K opens it",
   "what": "Esc closes it and gives focus back; ⌘K (Ctrl K) closes it too."
  },
  {
   "id": "ky-help",
   "label": "The key list",
   "kind": "state",
   "sublabel": "? opens it",
   "what": "One of search, the key list and the menus is open at a time."
  },
  {
   "id": "ky-menu",
   "label": "A menu",
   "kind": "state",
   "sublabel": "Export, Stories, Lenses",
   "what": "Esc closes it and gives focus back to its button."
  },
  {
   "id": "ky-pill",
   "label": "The view's popover",
   "kind": "state",
   "sublabel": "i opens it",
   "what": "The popover of the view's pill."
  },
  {
   "id": "ky-recorder",
   "label": "The recorder",
   "kind": "state",
   "sublabel": "asks if not saved",
   "what": "Export ▸ Record a story...: Esc closes it, asking first while it holds steps not saved."
  },
  {
   "id": "ky-story",
   "label": "A story",
   "kind": "state",
   "sublabel": "stopped: play(null)",
   "what": "Esc or Backspace stops the story shown."
  },
  {
   "id": "ky-trip",
   "label": "A tour or replay",
   "kind": "state",
   "sublabel": "Esc ends it",
   "what": "Esc ends it and says so: \"Tour stopped\", \"Replay stopped\"."
  },
  {
   "id": "ky-selection",
   "label": "The selection",
   "kind": "state",
   "sublabel": "Esc clears it"
  },
  {
   "id": "ky-up",
   "label": "Up a level",
   "kind": "state",
   "sublabel": "else: at the top",
   "what": "Esc or Backspace with nothing selected goes up a level; at the top, the hint line says \"Already at the top\"."
  },
  {
   "id": "mc-asked",
   "label": "A page tool",
   "kind": "ai",
   "icon": "bot",
   "sublabel": "show_view, highlight...",
   "what": "`show_view`, `highlight`, `tour`, `play_story` or `clear`. A view, card, line or story the model lacks is an error, and nothing is sent."
  },
  {
   "id": "mc-want",
   "label": "Folded",
   "kind": "state",
   "sublabel": "view, highlight, tour, story",
   "what": "The latest of each, so a page that opens later shows what the assistant built, not its last command."
  },
  {
   "id": "mc-sent",
   "label": "Sent",
   "kind": "state",
   "sublabel": "to each open page",
   "what": "One event (Server-Sent Events) to each open page."
  },
  {
   "id": "mc-showing",
   "label": "Shown on the page",
   "kind": "frontend",
   "icon": "window",
   "sublabel": "once, within 5 s",
   "what": "The page shows each command once, one at a time; one that takes more than 5 s is answered as not shown."
  },
  {
   "id": "mc-acked",
   "label": "Acknowledged",
   "kind": "state",
   "sublabel": "its MapState, posted",
   "what": "The page posts its `MapState` with the command's id, or the error that stopped it."
  },
  {
   "id": "mc-answer",
   "label": "Answered",
   "kind": "ai",
   "icon": "checks",
   "sublabel": "Shown on 1 page",
   "what": "\"Shown on 1 page at ..., on view ...\". Otherwise the tool says the page could not show it and why, that the open pages did not show it within 6 s, or that no page is connected and the URL to open."
  },
  {
