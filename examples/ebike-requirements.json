  "title": "E-bike: requirements",
  "root": "requirements",
  "nodes": [
    {"id": "spec", "type": "sysml.Requirement", "label": "E-bike specification", "props": {"reqId": "EB-1", "text": "The e-bike shall serve as a shared city bike that riders hire from a dock and return to a dock."}},
    {"id": "assist", "type": "sysml.Requirement", "label": "Pedal assistance", "parent": "spec", "props": {"reqId": "EB-1.1", "text": "The motor shall assist the rider only while the rider is pedalling."}},
    {"id": "cut-off", "type": "sysml.Requirement", "label": "Assistance cut-off", "parent": "assist", "props": {"reqId": "EB-1.1.1", "text": "Assistance shall fall away progressively and stop when the bike reaches 25 km/h."}},
    {"id": "range", "type": "sysml.Requirement", "label": "Range", "parent": "spec", "props": {"reqId": "EB-1.2", "text": "A full charge shall give at least 60 km of assisted riding."}},
    {"id": "docking", "type": "sysml.Requirement", "label": "Docking", "parent": "spec", "props": {"reqId": "EB-1.3", "text": "The e-bike shall lock into a dock when it is returned and shall charge while it is docked."}},
    {"id": "lock-time", "type": "sysml.Requirement", "label": "Locking time", "parent": "docking", "props": {"reqId": "EB-1.3.1", "text": "The dock shall lock the e-bike within 2 s of the bike being pushed in."}},
    {"id": "capacity", "type": "sysml.Requirement", "label": "Battery capacity", "props": {"reqId": "BAT-1", "text": "The battery shall store at least 500 Wh."}},
    {"id": "assist-curve", "type": "sysml.Requirement", "label": "Assistance curve", "props": {"reqId": "CTL-1", "text": "Assistance shall follow pedal torque and shall not exceed 250 W of continuous power."}},
    {"id": "legal-speed", "type": "sysml.Requirement", "label": "Maximum assisted speed", "props": {"reqId": "REG-3", "text": "Assistance shall fall away progressively and stop when the bike reaches 25 km/h."}},
    {"id": "availability", "type": "sysml.Requirement", "label": "All-day availability", "props": {"reqId": "CITY-4", "text": "A bike shall last a full day of hires on one charge."}},
    {"id": "battery", "type": "sysml.Block", "label": "Battery"},
    {"id": "controller", "type": "sysml.Block", "label": "Controller"},
    {"id": "dock", "type": "sysml.Block", "label": "Dock"},
