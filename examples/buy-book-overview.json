{
  "schemaVersion": 2,
  "title": "Bookshop: buying a book",
  "root": "buy-book",
  "nodes": [
    { "id": "buy-start", "type": "uml.InitialNode" },
    { "id": "ref-find", "type": "uml.InteractionUse", "label": "Find a book", "opensView": "find-book" },
    { "id": "try-payment", "type": "uml.MergeNode" },
    { "id": "ref-checkout", "type": "uml.InteractionUse", "label": "Check out", "opensView": "buy-checkout" },
    { "id": "payment-ok", "type": "uml.DecisionNode", "label": "Payment accepted?" },
    { "id": "buy-split", "type": "uml.ForkNode" },
    { "id": "ref-receipt", "type": "uml.InteractionUse", "label": "Email the receipt", "opensView": "email-receipt" },
    { "id": "sd-queue", "type": "uml.Interaction", "label": "Queue the order", "opensView": "queue-order" },
    { "id": "both-done", "type": "uml.JoinNode" },
    { "id": "buy-done", "type": "uml.ActivityFinalNode" },
    { "id": "lifeline-shopper", "type": "uml.Lifeline", "label": "shopper", "props": { "represents": "Shopper", "stereotypes": ["actor"] } },
    { "id": "lifeline-storefront", "type": "uml.Lifeline", "label": "storefront", "props": { "represents": "Storefront" } },
    { "id": "lifeline-api", "type": "uml.Lifeline", "label": "api", "props": { "represents": "ShopApi" } },
    { "id": "lifeline-payments", "type": "uml.Lifeline", "label": "payments", "props": { "represents": "PaymentProvider" } },
    { "id": "email", "type": "uml.Lifeline", "label": "email", "props": { "represents": "EmailService" } },
    { "id": "lifeline-queue", "type": "uml.Lifeline", "label": "queue", "props": { "represents": "OrderQueue" } },
    { "id": "lifeline-worker", "type": "uml.Lifeline", "label": "worker", "props": { "represents": "OrderWorker" } }
  ],
  "edges": [
    { "id": "f-buy-start", "type": "uml.ControlFlow", "from": "buy-start", "to": "ref-find" },
    { "id": "f-found", "type": "uml.ControlFlow", "from": "ref-find", "to": "try-payment" },
    { "id": "f-pay", "type": "uml.ControlFlow", "from": "try-payment", "to": "ref-checkout" },
    { "id": "f-result", "type": "uml.ControlFlow", "from": "ref-checkout", "to": "payment-ok" },
    { "id": "f-accepted", "type": "uml.ControlFlow", "from": "payment-ok", "to": "buy-split", "props": { "guard": "payment accepted" } },
    { "id": "f-declined", "type": "uml.ControlFlow", "from": "payment-ok", "to": "try-payment", "props": { "guard": "else" } },
    { "id": "f-to-receipt", "type": "uml.ControlFlow", "from": "buy-split", "to": "ref-receipt" },
    { "id": "f-to-queue", "type": "uml.ControlFlow", "from": "buy-split", "to": "sd-queue" },
    { "id": "f-receipt-sent", "type": "uml.ControlFlow", "from": "ref-receipt", "to": "both-done" },
    { "id": "f-queued", "type": "uml.ControlFlow", "from": "sd-queue", "to": "both-done" },
    { "id": "f-buy-done", "type": "uml.ControlFlow", "from": "both-done", "to": "buy-done" }
  ],
  "views": [
    { "id": "buy-book", "diagram": "uml.interaction-overview", "title": "Buying a book", "parent": null, "direction": "down",
      "nodeIds": ["buy-start", "ref-find", "try-payment", "ref-checkout", "payment-ok", "buy-split", "ref-receipt", "sd-queue", "both-done", "buy-done"] },
    { "id": "find-book", "diagram": "uml.sequence", "title": "Find a book", "parent": "buy-book",
      "nodeIds": ["lifeline-shopper", "lifeline-storefront", "lifeline-api"],
      "edges": [
        { "id": "find-1", "type": "uml.Message", "from": "lifeline-shopper", "to": "lifeline-storefront", "label": "search(title)", "props": { "sort": "call" } },
        { "id": "find-2", "type": "uml.Message", "from": "lifeline-storefront", "to": "lifeline-api", "label": "findBooks(title)", "props": { "sort": "call" } },
        { "id": "find-3", "type": "uml.Message", "from": "lifeline-api", "to": "lifeline-storefront", "label": "books", "props": { "sort": "reply", "replyTo": "find-2" } },
        { "id": "find-4", "type": "uml.Message", "from": "lifeline-storefront", "to": "lifeline-shopper", "label": "results page", "props": { "sort": "reply", "replyTo": "find-1" } }
      ] },
    { "id": "buy-checkout", "diagram": "uml.sequence", "title": "Check out", "parent": "buy-book",
      "nodeIds": ["lifeline-storefront", "lifeline-api", "lifeline-payments"],
      "edges": [
        { "id": "pay-1", "type": "uml.Message", "from": "lifeline-storefront", "to": "lifeline-api", "label": "place(order)", "props": { "sort": "call" } },
        { "id": "pay-2", "type": "uml.Message", "from": "lifeline-api", "to": "lifeline-payments", "label": "charge(total)", "props": { "sort": "call" } },
        { "id": "pay-3", "type": "uml.Message", "from": "lifeline-payments", "to": "lifeline-api", "label": "accepted or declined", "props": { "sort": "reply", "replyTo": "pay-2" } },
        { "id": "pay-4", "type": "uml.Message", "from": "lifeline-api", "to": "lifeline-storefront", "label": "result", "props": { "sort": "reply", "replyTo": "pay-1" } }
      ] },
    { "id": "email-receipt", "diagram": "uml.sequence", "title": "Email the receipt", "parent": "buy-book",
      "nodeIds": ["lifeline-api", "email", "lifeline-shopper"],
      "edges": [
        { "id": "mail-1", "type": "uml.Message", "from": "lifeline-api", "to": "email", "label": "send(receipt)", "props": { "sort": "async" } },
        { "id": "mail-2", "type": "uml.Message", "from": "email", "to": "lifeline-shopper", "label": "receipt email", "props": { "sort": "async" } }
      ] },
    { "id": "queue-order", "diagram": "uml.sequence", "title": "Queue the order", "parent": "buy-book",
      "nodeIds": ["lifeline-api", "lifeline-queue", "lifeline-worker"],
      "edges": [
        { "id": "queue-1", "type": "uml.Message", "from": "lifeline-api", "to": "lifeline-queue", "label": "enqueue(order)", "props": { "sort": "call" } },
        { "id": "queue-2", "type": "uml.Message", "from": "lifeline-queue", "to": "lifeline-api", "label": "queued", "props": { "sort": "reply", "replyTo": "queue-1" } },
        { "id": "queue-3", "type": "uml.Message", "from": "lifeline-queue", "to": "lifeline-worker", "label": "orderPlaced", "props": { "sort": "async" } }
      ] }
  ]
}
