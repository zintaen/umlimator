   "props": {
    "stereotypes": [
     "linux server"
    ]
   }
  },
  {
   "id": "queue",
   "type": "uml.Node",
   "label": "Order queue"
  },
  {
   "id": "shop-api",
   "type": "uml.Component",
   "label": "Shop API"
  },
  {
   "id": "order-worker",
   "type": "uml.Component",
   "label": "Order worker"
  },
  {
   "id": "note-config",
   "type": "uml.Comment",
   "label": "Holds the pool size and the card gateway's keys"
  }
 ],
 "edges": [
  {
   "id": "routes-on-edge",
   "type": "uml.Deployment",
   "from": "routes",
   "to": "edge"
  },
  {
   "id": "api-jar-manifests",
   "type": "uml.Manifestation",
   "from": "api-jar",
   "to": "shop-api"
  },
  {
   "id": "worker-jar-manifests",
   "type": "uml.Manifestation",
   "from": "worker-jar",
   "to": "order-worker"
  },
  {
   "id": "config-for-api",
   "type": "uml.Dependency",
   "from": "api-config",
   "to": "api-jar"
  },
  {
   "id": "device-to-edge",
   "type": "uml.CommunicationPath",
   "from": "shopper-device",
   "to": "edge",
   "label": "HTTPS"
  },
  {
   "id": "edge-to-app",
   "type": "uml.CommunicationPath",
   "from": "edge",
   "to": "app-server",
   "label": "HTTP"
  },
  {
   "id": "app-to-db",
   "type": "uml.CommunicationPath",
   "from": "app-server",
   "to": "db-host",
   "label": "PostgreSQL wire protocol"
  },
  {
   "id": "app-to-queue",
   "type": "uml.CommunicationPath",
   "from": "app-server",
   "to": "queue",
   "label": "AMQP"
  },
  {
   "id": "note-config-link",
   "type": "uml.CommentLink",
   "from": "note-config",
   "to": "api-config"
  }
 ],
