   "type": "uml.Device",
   "label": "Application server",
   "parent": "datacentre"
  },
  {
   "id": "jvm",
   "type": "uml.ExecutionEnvironment",
   "label": "Java 21 runtime",
   "parent": "app-server"
  },
  {
   "id": "api-jar",
   "type": "uml.Artifact",
   "label": "shop-api.jar",
   "parent": "jvm"
