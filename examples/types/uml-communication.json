   "edges": ["c-shopper-storefront", "c-storefront-api", "c-api-self", "c-api-payments", "c-payments-bank", "c-api-basket", "c-api-receipt", "c-api-stock",
    "m-checkout", "m-place", "m-validate", "m-charge", "m-authorise", "m-approved", "m-paid", "m-new-receipt", "m-clear", "m-placed", "m-result", "m-page"] },
  { "id": "checkout-right", "diagram": "uml.communication", "title": "The same checkout, laid out right", "parent": "checkout", "direction": "right",
   "nodeIds": ["shopper", "storefront", "api", "payments", "bank", "basket", "receipt", "stock"],
   "edges": ["c-shopper-storefront", "c-storefront-api", "c-api-self", "c-api-payments", "c-payments-bank", "c-api-basket", "c-api-receipt", "c-api-stock",
    "m-checkout", "m-place", "m-validate", "m-charge", "m-authorise", "m-approved", "m-paid", "m-new-receipt", "m-clear", "m-placed", "m-result", "m-page"] }
