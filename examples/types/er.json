   "id": "card-bookshop-schema-er-schema",
   "label": "Bookshop schema",
   "kind": "file",
   "sublabel": "keys, crow's foot, junction table",
   "what": "Tables and their columns as rows, related in crow's foot or IDEF1X on one geometry: a composite key, a junction table, a nullable foreign key, a self-reference.",
   "how": "From examples/bookshop-schema.json.",
   "opensView": "bookshop-schema-er-schema"
  },
  {
   "id": "card-docks-idef1x",
   "label": "Hire schema in IDEF1X",
   "kind": "file",
   "sublabel": "IDEF1X, dependent entities",
   "what": "A cycle hire schema in IDEF1X: identifying relationships make dock and hire_point dependent entities with rounded corners, a dot and P or Z at each child, a diamond at an optional parent.",
   "how": "From examples/variants/er-docks.json.",
   "opensView": "docks-idef1x"
  },
  {
   "id": "card-docks-crowsfoot-down",
   "label": "Hire schema in crow's foot, laid out down",
   "kind": "file",
   "sublabel": "crow's foot, laid out down",
   "what": "The same schema in crow's foot laid out down, showing all four end forms (exactly one, zero or one, one or more, zero or more) and a note on a table.",
   "how": "From examples/variants/er-docks.json.",
   "opensView": "docks-crowsfoot-down"
  },
  {
