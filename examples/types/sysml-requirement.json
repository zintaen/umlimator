  {
   "id": "ebike-requirements-spec",
   "type": "sysml.Requirement",
   "label": "E-bike specification",
   "props": {
    "reqId": "EB-1",
    "text": "The e-bike shall serve as a shared city bike that riders hire from a dock and return to a dock."
   }
  },
  {
   "id": "ebike-requirements-assist",
   "type": "sysml.Requirement",
   "label": "Pedal assistance",
   "parent": "ebike-requirements-spec",
   "props": {
    "reqId": "EB-1.1",
    "text": "The motor shall assist the rider only while the rider is pedalling."
   }
  },
  {
   "id": "ebike-requirements-cut-off",
   "type": "sysml.Requirement",
   "label": "Assistance cut-off",
   "parent": "ebike-requirements-assist",
   "props": {
    "reqId": "EB-1.1.1",
    "text": "Assistance shall fall away progressively and stop when the bike reaches 25 km/h."
   }
  },
  {
   "id": "ebike-requirements-range",
   "type": "sysml.Requirement",
   "label": "Range",
   "parent": "ebike-requirements-spec",
   "props": {
    "reqId": "EB-1.2",
    "text": "A full charge shall give at least 60 km of assisted riding."
   }
  },
  {
   "id": "ebike-requirements-docking",
   "type": "sysml.Requirement",
   "label": "Docking",
   "parent": "ebike-requirements-spec",
   "props": {
    "reqId": "EB-1.3",
    "text": "The e-bike shall lock into a dock when it is returned and shall charge while it is docked."
   }
  },
  {
   "id": "ebike-requirements-lock-time",
   "type": "sysml.Requirement",
   "label": "Locking time",
   "parent": "ebike-requirements-docking",
   "props": {
    "reqId": "EB-1.3.1",
    "text": "The dock shall lock the e-bike within 2 s of the bike being pushed in."
   }
  },
  {
   "id": "ebike-requirements-capacity",
   "type": "sysml.Requirement",
   "label": "Battery capacity",
   "props": {
    "reqId": "BAT-1",
    "text": "The battery shall store at least 500 Wh."
   }
  },
  {
   "id": "ebike-requirements-assist-curve",
   "type": "sysml.Requirement",
   "label": "Assistance curve",
   "props": {
    "reqId": "CTL-1",
    "text": "Assistance shall follow pedal torque and shall not exceed 250 W of continuous power."
   }
  },
  {
   "id": "ebike-requirements-legal-speed",
   "type": "sysml.Requirement",
   "label": "Maximum assisted speed",
   "props": {
    "reqId": "REG-3",
    "text": "Assistance shall fall away progressively and stop when the bike reaches 25 km/h."
   }
  },
  {
