 "nodes": [
  {
   "id": "card-bookshop-profile-profile",
   "label": "Bookshop conventions profile",
   "kind": "file",
   "sublabel": "stereotypes, extensions, tags",
   "what": "Stereotypes with tag definitions extending metaclasses, a required extension, a profile applied to a package, and an element's tags in a compartment per stereotype; stereotypes applied anywhere in the model are checked against it.",
   "how": "From examples/bookshop-profile.json.",
   "opensView": "bookshop-profile-profile"
  },
  {
   "id": "card-abstract-fleet-profile",
   "label": "An abstract stereotype and an enumeration tag",
   "kind": "file",
   "sublabel": "abstract stereotype, enumeration tag",
   "what": "A cycle hire profile whose abstract <<asset>> stereotype is specialized by <<vehicle>> and <<station>>, a tag typed by the profile's own enumeration, a tag with a default, and classes showing their tags in a compartment per stereotype, inherited tags included.",
   "how": "From examples/variants/uml-profile-abstract.json.",
   "opensView": "abstract-fleet-profile"
  },
  {
   "id": "card-two-two-profiles",
   "label": "Two profiles, one name, qualified",
   "kind": "file",
   "sublabel": "two profiles, qualified names",
   "what": "A library package applying two profiles that both define <<record>>, told apart as `Storage::record` and `Audit::record`, and a required extension of Package that puts <<owner>> over a closed package with no stereotype stored.",
   "how": "From examples/variants/uml-profile-two.json.",
   "opensView": "two-two-profiles"
  },
