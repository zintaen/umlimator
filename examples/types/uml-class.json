   "opensView": "sales-classes-payments-only"
  },
  {
   "id": "card-members-members",
   "label": "Member notation",
   "kind": "file",
   "sublabel": "visibility, static, derived, rows",
   "what": "Every member notation: the four visibilities (+ - # ~), a static attribute and operation underlined, a derived attribute, defaults and multiplicities, parameters with their direction, an abstract class and operation in italics, a primitive type and a data type, and a class cut to 3 rows then \"+k more\".",
   "how": "From examples/variants/uml-class-members.json.",
   "opensView": "members-members"
  },
  {
   "id": "card-lines-lines",
   "label": "Every kind of line",
   "kind": "file",
   "sublabel": "associations, usage, abstraction",
   "what": "Every kind of line a class view draws: an association navigable both ways, roles and multiplicities, composite and shared aggregation, an interface realization, a usage, an abstraction, a plain dependency with a name and a comment link, listed in the view's `edges`.",
   "how": "From examples/variants/uml-class-lines.json.",
   "opensView": "lines-lines"
  },
  {
   "id": "card-hierarchy-right",
   "label": "Hierarchy, laid out right",
   "kind": "file",
   "sublabel": "abstract class, interfaces, an enumeration",
