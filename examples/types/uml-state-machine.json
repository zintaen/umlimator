  {
   "id": "card-order-states-order-life",
   "label": "An order's life",
   "kind": "file",
   "sublabel": "regions, history, choice",
   "what": "States with their activities, composite states as boxes with orthogonal regions, a choice, a fork and a join, a shallow history and a terminate, and transitions written `trigger [guard] / effect`.",
   "how": "From examples/order-states.json.",
   "opensView": "order-states-order-life"
  },
  {
   "id": "card-loan-loan",
   "label": "A library loan",
   "kind": "file",
   "sublabel": "deep history, a junction, a note",
   "what": "A library loan: a composite state left on a closure and re-entered by its deep history (H*), a junction merging two returns, an internal transition with a guard, a final state and a note on the history.",
   "how": "From examples/variants/uml-state-machine-loan.json.",
   "opensView": "loan-loan"
  },
  {
   "id": "card-coffee-machine",
   "label": "A coffee machine, down",
   "kind": "file",
   "sublabel": "down, a closed composite",
   "what": "A coffee machine laid out down: entry, do and exit rows, two internal transitions, Brewing as a closed composite with UML's decomposition mark (its substates not shown), and Descaling with its activities collapsed.",
   "how": "From examples/variants/uml-state-machine-coffee.json.",
   "opensView": "coffee-machine"
  },
