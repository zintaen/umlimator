   "from": "stock-ready",
   "to": "split"
  },
  {
   "id": "f-to-pay",
   "type": "uml.ControlFlow",
   "from": "split",
   "to": "call-payment"
  },
  {
   "id": "f-to-pick",
   "type": "uml.ControlFlow",
   "from": "split",
   "to": "pick"
  },
  {
   "id": "f-to-tell",
   "type": "uml.ControlFlow",
   "from": "split",
   "to": "tell-shopper"
  },
  {
   "id": "f-told",
   "type": "uml.ControlFlow",
   "from": "tell-shopper",
   "to": "told"
  },
  {
   "id": "f-paid",
   "type": "uml.ControlFlow",
   "from": "call-payment",
   "to": "packed-and-paid"
  },
  {
   "id": "f-packed",
   "type": "uml.ControlFlow",
   "from": "pick",
   "to": "packed-and-paid"
  },
  {
   "id": "f-ship",
   "type": "uml.ControlFlow",
   "from": "packed-and-paid",
   "to": "ship"
  },
  {
   "id": "f-done",
   "type": "uml.ControlFlow",
   "from": "ship",
   "to": "done"
  },
  {
   "id": "note-stock-link",
   "type": "uml.CommentLink",
   "from": "note-stock",
   "to": "in-stock"
  },
  {
   "id": "f-pay-start",
   "type": "uml.ControlFlow",
   "from": "pay-start",
   "to": "pay-again"
  },
  {
   "id": "f-pay-try",
   "type": "uml.ControlFlow",
   "from": "pay-again",
   "to": "charge"
  },
  {
   "id": "f-charged",
   "type": "uml.ControlFlow",
   "from": "charge",
   "to": "accepted"
  },
  {
   "id": "f-accepted",
   "type": "uml.ControlFlow",
   "from": "accepted",
   "to": "record",
   "label": "paid",
   "props": {
    "guard": "yes"
   }
  },
  {
   "id": "f-declined",
   "type": "uml.ControlFlow",
   "from": "accepted",
   "to": "ask-card",
   "props": {
    "guard": "else"
   }
  },
  {
   "id": "f-retry",
   "type": "uml.ControlFlow",
   "from": "ask-card",
   "to": "pay-again"
  },
  {
   "id": "f-recorded",
   "type": "uml.ControlFlow",
   "from": "record",
   "to": "pay-done"
  }
 ],
