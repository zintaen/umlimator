{
 "$schema": "../../lib/umlimator.schema.json",
 "schemaVersion": 2,
 "title": "Activity diagram",
 "root": "fulfil",
 "nodes": [
  {
   "id": "lane-shop",
   "type": "uml.ActivityPartition",
   "label": "Bookshop"
  },
  {
   "id": "lane-desk",
   "type": "uml.ActivityPartition",
   "label": "Order desk",
   "parent": "lane-shop"
  },
  {
   "id": "lane-warehouse",
   "type": "uml.ActivityPartition",
   "label": "Warehouse",
   "parent": "lane-shop"
  },
  {
   "id": "lane-email",
   "type": "uml.ActivityPartition",
   "label": "Email service"
  },
  {
   "id": "start",
   "type": "uml.InitialNode",
   "parent": "lane-desk"
  },
  {
   "id": "take-order",
   "type": "uml.Action",
   "label": "Take the next order from the queue",
   "parent": "lane-desk"
  },
  {
   "id": "order-object",
   "type": "uml.ObjectNode",
   "label": "Order",
   "parent": "lane-desk"
  },
  {
   "id": "check-stock",
   "type": "uml.Action",
   "label": "Check the stock of each book",
   "parent": "lane-warehouse"
  },
  {
   "id": "stock",
   "type": "uml.DataStoreNode",
   "label": "Stock levels",
   "parent": "lane-warehouse"
  },
  {
   "id": "in-stock",
   "type": "uml.DecisionNode",
   "label": "All books in stock?",
   "parent": "lane-warehouse"
  },
  {
   "id": "ask-restock",
   "type": "uml.SendSignalAction",
   "label": "Restock request",
   "parent": "lane-warehouse"
  },
  {
   "id": "books-arrive",
   "type": "uml.AcceptEventAction",
   "label": "Books delivered",
   "parent": "lane-warehouse"
  },
  {
   "id": "stock-ready",
   "type": "uml.MergeNode",
   "parent": "lane-warehouse",
   "label": "books ready"
  },
  {
   "id": "split",
   "type": "uml.ForkNode",
   "parent": "lane-desk"
  },
  {
   "id": "call-payment",
   "type": "uml.CallBehaviorAction",
   "label": "Take payment",
   "parent": "lane-desk",
   "opensView": "take-payment"
  },
  {
   "id": "pick",
   "type": "uml.Action",
   "label": "Pick and pack the books",
   "parent": "lane-warehouse"
  },
  {
   "id": "tell-shopper",
   "type": "uml.Action",
   "label": "Email \"your order is being packed\"",
   "parent": "lane-email"
  },
  {
   "id": "told",
   "type": "uml.FlowFinalNode",
   "parent": "lane-email"
  },
  {
   "id": "packed-and-paid",
   "type": "uml.JoinNode",
   "parent": "lane-warehouse"
  },
  {
   "id": "ship",
   "type": "uml.Action",
   "label": "Hand the parcel to the carrier",
   "parent": "lane-warehouse"
  },
  {
   "id": "done",
   "type": "uml.ActivityFinalNode",
   "parent": "lane-warehouse"
  },
  {
   "id": "note-stock",
   "type": "uml.Comment",
   "label": "In stock means every line of the order, not just the first book"
  },
  {
   "id": "pay-start",
   "type": "uml.InitialNode"
  },
  {
   "id": "pay-again",
   "type": "uml.MergeNode",
   "label": "try a card"
  },
  {
   "id": "charge",
   "type": "uml.Action",
   "label": "Charge the customer's card"
  },
  {
   "id": "accepted",
   "type": "uml.DecisionNode",
   "label": "Card accepted?"
  },
  {
   "id": "ask-card",
   "type": "uml.Action",
   "label": "Ask for another card"
  },
  {
   "id": "record",
   "type": "uml.Action",
   "label": "Record the payment on the order"
  },
  {
   "id": "pay-done",
   "type": "uml.ActivityFinalNode"
  }
 ],
 "edges": [
