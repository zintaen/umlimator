  {
   "id": "card-bookshop-packages-packages",
   "label": "Bookshop packages",
   "kind": "file",
   "sublabel": "nesting, import, access, merge",
   "what": "Packages as boxes holding what they own, a package inside a package, two classes named Order in two packages, `<<import>>`, `<<access>>`, `<<merge>>` and a dependency between them, and a profile applied by `<<apply>>`.",
   "how": "From examples/bookshop-packages.json.",
   "opensView": "bookshop-packages-packages"
  },
  {
   "id": "card-closed-closed",
   "label": "Cycle hire packages, closed",
   "kind": "file",
   "sublabel": "closed folders, stereotypes, a note",
   "what": "Five packages with none of their contents in the view, so each is drawn as a closed folder with its name in the body; `<<subsystem>>` and `<<library>>` stereotypes, a public import, a private import drawn as `<<access>>`, a `<<use>>` dependency and a note on one package.",
   "how": "From examples/variants/uml-package-closed.json.",
   "opensView": "closed-closed"
  },
  {
   "id": "card-nested-nested",
   "label": "Library packages, three deep",
   "kind": "file",
   "sublabel": "three levels deep, laid out down",
   "what": "A package inside a package inside a package, each box holding its classes, an enumeration and an interface; an import from lending to catalogue, and `<<use>>` and `<<call>>` dependencies that cross the box borders.",
   "how": "From examples/variants/uml-package-nested.json.",
   "opensView": "nested-nested"
  },
  {
   "id": "card-nested-qualified",
   "label": "Library classes by qualified name",
   "kind": "file",
   "sublabel": "qualified names from a subject",
   "what": "The same classes with no package drawn: the view's `subject` is the library package, so each class is named by the packages between it and the subject, such as lending::holds::Hold.",
   "how": "From examples/variants/uml-package-nested.json.",
   "opensView": "nested-qualified"
  },
