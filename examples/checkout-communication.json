{
  "schemaVersion": 2,
  "title": "Bookshop: checkout, as a communication diagram",
  "root": "checkout-communication",
  "nodes": [
    { "id": "lifeline-shopper", "type": "uml.Lifeline", "label": "shopper", "props": { "represents": "Shopper", "stereotypes": ["actor"] } },
    { "id": "lifeline-storefront", "type": "uml.Lifeline", "label": "storefront", "props": { "represents": "Storefront" } },
    { "id": "lifeline-api", "type": "uml.Lifeline", "label": "api", "props": { "represents": "ShopApi" } },
    { "id": "lifeline-payments", "type": "uml.Lifeline", "label": "payments", "props": { "represents": "PaymentProvider" } },
    { "id": "receipt", "type": "uml.Lifeline", "label": "receipt", "props": { "represents": "Receipt" } }
  ],
  "edges": [
    { "id": "shopper-storefront", "type": "uml.Connector", "from": "lifeline-shopper", "to": "lifeline-storefront" },
    { "id": "storefront-api", "type": "uml.Connector", "from": "lifeline-storefront", "to": "lifeline-api" },
    { "id": "api-self", "type": "uml.Connector", "from": "lifeline-api", "to": "lifeline-api" },
