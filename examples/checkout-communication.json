    { "id": "api-receipt", "type": "uml.Connector", "from": "lifeline-api", "to": "receipt" },
    { "id": "cm1", "type": "uml.Message", "from": "lifeline-shopper", "to": "lifeline-storefront", "label": "checkout()", "props": { "sort": "call" } },
    { "id": "cm2", "type": "uml.Message", "from": "lifeline-storefront", "to": "lifeline-api", "label": "place(order)", "props": { "sort": "call" } },
    { "id": "cm3", "type": "uml.Message", "from": "lifeline-api", "to": "lifeline-api", "label": "validate(order)", "props": { "sort": "call" } },
    { "id": "cm4", "type": "uml.Message", "from": "lifeline-api", "to": "lifeline-payments", "label": "charge(total)", "props": { "sort": "call" } },
    { "id": "cm5", "type": "uml.Message", "from": "lifeline-payments", "to": "lifeline-api", "label": "paid", "props": { "sort": "reply", "replyTo": "cm4" } },
    { "id": "cm6", "type": "uml.Message", "from": "lifeline-api", "to": "receipt", "label": "new(order)", "props": { "sort": "create" } },
    { "id": "cm7", "type": "uml.Message", "from": "lifeline-api", "to": "lifeline-storefront", "label": "orderPlaced", "props": { "sort": "async" } },
    { "id": "cm8", "type": "uml.Message", "from": "lifeline-api", "to": "lifeline-storefront", "label": "result", "props": { "sort": "reply", "replyTo": "cm2" } },
    { "id": "cm9", "type": "uml.Message", "from": "lifeline-storefront", "to": "lifeline-shopper", "label": "confirmation page", "props": { "sort": "reply", "replyTo": "cm1" } }
  ],
