        { "id": "m3", "type": "uml.Message", "from": "lifeline-api", "to": "lifeline-api", "label": "validate(order)", "props": { "sort": "call" } },
        { "id": "m4", "type": "uml.Message", "from": "lifeline-api", "to": "lifeline-payments", "label": "charge(total)", "props": { "sort": "call" } },
