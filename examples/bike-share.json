{
  "$schema": "../lib/umlimator.schema.json",
  "title": "Bike share, an example",
  "root": "context",
  "nodes": [
    { "id": "riders", "label": "Riders", "kind": "frontend", "icon": "users", "sublabel": "unlock, ride, pay",
      "what": "People who hire a bike from a dock.", "when": "Every ride.", "how": "They use the rider app on a phone." },
    { "id": "ops", "label": "Operations team", "kind": "frontend", "icon": "usercheck", "sublabel": "rebalance, repair",
      "what": "Staff who keep bikes where riders want them.", "when": "All day, in shifts.", "how": "They plan van routes in the ops console." },
    { "id": "bikeshare", "label": "Bike share", "kind": "backend", "icon": "layers", "sublabel": "the whole system", "opensView": "system",
      "what": "Everything the city's bike share runs on.", "when": "Always on.", "how": "Apps, services and data on one platform. Double-click to go in." },
    { "id": "payments", "label": "Payment provider", "kind": "external", "icon": "building", "sublabel": "cards and wallets", "noSub": true,
      "what": "Takes card and wallet payments.", "when": "At the end of each ride.", "how": "A REST API; the bike share never stores card numbers." },
    { "id": "maps", "label": "Map tiles", "kind": "external", "icon": "network", "sublabel": "street maps",
      "what": "Street maps for the app.", "when": "Whenever a rider opens the map.", "how": "Tiles over HTTPS, cached on the phone." },
    { "id": "city", "label": "City data portal", "kind": "external", "icon": "building", "sublabel": "open data",
      "what": "The city's open-data site.", "when": "Weekly.", "how": "Receives anonymised trips as CSV." },

    { "id": "rider-app", "label": "Rider app", "kind": "frontend", "owner": "Apps", "icon": "window", "sublabel": "iOS, Android, web",
      "what": "Find a bike, unlock it, pay.", "when": "Every ride.", "how": "Calls the Trip service and the map tiles." },
    { "id": "ops-console", "label": "Ops console", "kind": "frontend", "owner": "Apps", "icon": "monitor", "sublabel": "web, staff only",
      "what": "Where the operations team plans the day.", "when": "Every shift.", "how": "Calls the Fleet service; shows low-battery alerts." },
    { "id": "accounts", "label": "Accounts", "kind": "security", "owner": "Rides", "icon": "key", "sublabel": "sign-in, tokens",
      "badges": [{ "text": "SSO", "tone": "green" }],
      "what": "Riders' and staff's accounts.", "when": "At sign-in, and on every call.", "how": "Issues tokens that the services check." },
    { "id": "trips", "label": "Trip service", "kind": "backend", "owner": "Rides", "icon": "server", "sublabel": "rides from unlock to end",
      "opensView": "trips", "opensCount": 6,
      "what": "Runs each ride.", "when": "Unlock, pause, end.", "how": "Prices a ride when it ends and charges it. Its inner view loads when you open it." },
    { "id": "pricing", "label": "Pricing", "kind": "backend", "owner": "Rides", "icon": "chart", "sublabel": "fares, passes, caps",
      "badges": [{ "text": "v2 beta", "tone": "amber" }], "edited": true,
      "what": "Works out what a ride costs.", "when": "When a ride ends.", "how": "Rules per city zone; v2 adds peak prices." },
    { "id": "fleet", "label": "Fleet service", "kind": "backend", "owner": "Fleet", "icon": "gauge", "sublabel": "bikes, docks, vans",
      "opensView": "fleet", "opensCount": 6,
      "what": "Knows where every bike is.", "when": "Every dock event.", "how": "Reads the telemetry stream and plans rebalancing. Its inner view loads when you open it." },
    { "id": "charging", "label": "Charging", "kind": "backend", "owner": "Fleet", "icon": "clock", "sublabel": "e-bike charging slots", "change": "planned",
      "what": "Books charging slots for e-bikes.", "when": "Planned for next year.", "how": "Not built yet." },
    { "id": "tripsdb", "label": "Trips database", "kind": "database", "owner": "Rides", "icon": "database", "sublabel": "PostgreSQL",
      "what": "Every ride and its fare.", "when": "Written as rides change.", "how": "One row per ride, kept seven years." },
    { "id": "telemetry", "label": "Telemetry stream", "kind": "queue", "owner": "Fleet", "icon": "queue", "sublabel": "Kafka",
      "badges": ["3 partitions"],
      "what": "Dock and bike events.", "when": "Every few seconds per dock.", "how": "Partitioned by dock; kept seven days." },
    { "id": "warehouse", "label": "Warehouse", "kind": "database", "owner": "Fleet", "icon": "archive", "sublabel": "hourly tables",
      "what": "History for reports and forecasts.", "when": "Loaded hourly.", "how": "Columnar tables; exports anonymised trips weekly." },
    { "id": "stations", "label": "Docking stations", "kind": "cloud", "owner": "Fleet", "icon": "gate", "sublabel": "400 docks",
      "what": "The docks on the street.", "when": "Always on.", "how": "Report each bike and battery over MQTT; open on command." },
    { "id": "monitoring", "label": "Monitoring", "kind": "cloud", "owner": "Platform", "icon": "chart", "sublabel": "metrics, alerts",
      "what": "Watches every service.", "when": "Every 15 seconds.", "how": "Scrapes each service's metrics endpoint." },
    { "id": "status", "label": "Status page", "kind": "cloud", "owner": "Platform", "icon": "alert", "sublabel": "public uptime",
      "what": "Tells riders when something is down.", "when": "During incidents.", "how": "Updated by hand; nothing calls it yet." },
    { "id": "flags", "label": "Feature flags", "kind": "cloud", "owner": "Platform", "icon": "flag", "sublabel": "staged roll-outs",
      "what": "Turns features on per city.", "when": "On each release.", "how": "Not wired to the services yet." },

    { "id": "trip-api", "label": "Trip API", "kind": "backend", "owner": "Rides", "icon": "server", "sublabel": "REST controllers",
      "what": "The Trip service's endpoints.", "when": "Every app call.", "how": "Validates the token, then hands on." },
    { "id": "unlock", "label": "Unlock coordinator", "kind": "backend", "owner": "Rides", "icon": "key", "sublabel": "opens a dock",
      "what": "Releases a bike.", "when": "When a ride starts.", "how": "Sends the dock an open command and waits for its reply." },
    { "id": "lifecycle", "label": "Trip lifecycle", "kind": "backend", "owner": "Rides", "icon": "state", "sublabel": "started, paused, ended",
      "what": "The state of each ride.", "when": "On every change.", "how": "A state machine; each change is saved and published." },
    { "id": "fare", "label": "Fare calculator", "kind": "backend", "owner": "Rides", "icon": "chart", "sublabel": "minutes, passes, caps",
      "what": "The price of a finished ride.", "when": "When a ride ends.", "how": "Asks Pricing for the rules, then charges the rider." },
    { "id": "trip-repo", "label": "Trip repository", "kind": "backend", "owner": "Rides", "icon": "database", "sublabel": "SQL, migrations",
      "what": "Reads and writes rides.", "when": "On every change.", "how": "One table per city." },
    { "id": "trip-events", "label": "Event publisher", "kind": "queue", "owner": "Rides", "icon": "webhook", "sublabel": "outbox",
      "what": "Tells the rest of the system about rides.", "when": "After each saved change.", "how": "An outbox table drained to the telemetry stream." },

    { "id": "dock-listener", "label": "Dock listener", "kind": "backend", "owner": "Fleet", "icon": "webhook", "sublabel": "reads dock events",
      "what": "Keeps the fleet's state current.", "when": "Every dock event.", "how": "Consumes the telemetry stream." },
    { "id": "battery", "label": "Battery monitor", "kind": "backend", "owner": "Fleet", "icon": "gauge", "sublabel": "under 20% is low",
      "what": "Finds e-bikes that need charging.", "when": "Every battery report.", "how": "Raises an alert in the ops console." },
    { "id": "forecast", "label": "Demand forecast", "kind": "ai", "owner": "Fleet", "icon": "sparkles", "sublabel": "bikes needed per dock",
      "what": "Predicts demand per dock, hourly.", "when": "Every hour.", "how": "A model trained on a year of trips." },
    { "id": "planner", "label": "Rebalance planner", "kind": "backend", "owner": "Fleet", "icon": "calendar", "sublabel": "van routes",
      "what": "Plans where the vans move bikes.", "when": "Each morning, and on request.", "how": "Matches the forecast against stock." },
    { "id": "fleet-api", "label": "Fleet API", "kind": "backend", "owner": "Fleet", "icon": "server", "sublabel": "REST",
      "what": "The Fleet service's endpoints.", "when": "Every console call.", "how": "Plans and moves." },
    { "id": "fleet-db", "label": "Fleet store", "kind": "database", "owner": "Fleet", "icon": "database", "sublabel": "bikes, docks, vans",
      "what": "Where every bike is.", "when": "Updated by each dock event.", "how": "A key-value store per dock." }
  ],
