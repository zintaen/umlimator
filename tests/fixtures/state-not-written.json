{
  "$schema": "../../lib/umlimator.schema.json",
  "schemaVersion": 2,
  "title": "What a state text leaves out",
  "root": "order-life",
  "nodes": [
    { "id": "created", "type": "uml.Pseudostate", "props": { "kind": "initial" } },
    { "id": "placed", "type": "uml.State", "label": "Placed", "props": { "entry": "reserve the books" } },
    { "id": "delivered", "type": "uml.FinalState" },
    { "id": "hold-note", "type": "uml.Comment", "label": "Placed waits for the payment" }
