    { "id": "t-delivered", "type": "uml.Transition", "from": "placed", "to": "delivered", "props": { "trigger": "parcel signed for" } },
    { "id": "hold-note-link", "type": "uml.CommentLink", "from": "hold-note", "to": "placed" }
  ],
  "views": [
    { "id": "order-life", "diagram": "uml.state-machine", "title": "An order's life", "nodeIds": ["created", "placed", "delivered", "hold-note"] }
