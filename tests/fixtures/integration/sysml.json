{
  "nodes": [
    {
      "id": "spec",
      "type": "sysml.Requirement",
      "label": "E-moped specification",
      "opensView": "blocks",
      "props": {
        "reqId": "EB-1",
        "text": "The e-moped shall serve as a shared city moped that riders hire from a dock and return to a dock."
      }
    },
    {
      "id": "assist",
      "type": "sysml.Requirement",
      "label": "Pedal assistance",
      "parent": "spec",
      "props": { "reqId": "EB-1.1", "text": "The motor shall assist the rider only while the rider is pedalling." }
    },
    {
      "id": "cut-off",
      "type": "sysml.Requirement",
      "label": "Assistance cut-off",
      "parent": "assist",
      "props": {
        "reqId": "EB-1.1.1",
        "text": "Assistance shall fall away progressively and stop when the moped reaches 25 km/h."
      }
    },
    {
      "id": "range",
      "type": "sysml.Requirement",
      "label": "Range",
      "parent": "spec",
      "opensView": "range-analysis",
      "props": { "reqId": "EB-1.2", "text": "A full charge shall give at least 60 km of assisted riding." }
    },
    {
      "id": "docking",
      "type": "sysml.Requirement",
      "label": "Docking",
      "parent": "spec",
      "props": {
        "reqId": "EB-1.3",
        "text": "The e-moped shall lock into a dock when it is returned and shall charge while it is docked."
      }
    },
    {
      "id": "lock-time",
      "type": "sysml.Requirement",
      "label": "Locking time",
      "parent": "docking",
      "props": {
        "reqId": "EB-1.3.1",
        "text": "The dock shall lock the e-moped within 2 s of the moped being pushed in."
      }
    },
    {
      "id": "capacity",
      "type": "sysml.Requirement",
      "label": "Battery capacity",
      "props": { "reqId": "BAT-1", "text": "The battery shall store at least 500 Wh." }
    },
    {
      "id": "assist-curve",
      "type": "sysml.Requirement",
      "label": "Assistance curve",
      "props": {
        "reqId": "CTL-1",
        "text": "Assistance shall follow pedal torque and shall not exceed 250 W of continuous power."
      }
    },
    {
      "id": "legal-speed",
      "type": "sysml.Requirement",
      "label": "Maximum assisted speed",
      "props": {
        "reqId": "REG-3",
        "text": "Assistance shall fall away progressively and stop when the moped reaches 25 km/h."
      }
    },
    {
      "id": "availability",
      "type": "sysml.Requirement",
      "label": "All-day availability",
      "props": { "reqId": "CITY-4", "text": "A moped shall last a full day of hires on one charge." }
    },
    {
      "id": "battery",
      "type": "sysml.Block",
      "label": "Battery",
      "members": [
        {
          "id": "battery.capacity",
          "type": "sysml.ValueProperty",
          "label": "capacity",
          "props": { "valueType": "Energy" }
        },
        {
          "id": "battery.cellVoltage",
          "type": "sysml.ValueProperty",
          "label": "cellVoltage",
          "props": { "valueType": "Voltage", "multiplicity": "10" }
        },
        {
          "id": "battery.charge",
          "type": "sysml.Port",
          "label": "charge",
          "props": { "valueType": "ChargeInterface" }
        },
        { "id": "battery.power", "type": "sysml.Port", "label": "power" },
        { "id": "battery.bus", "type": "sysml.Port", "label": "bus" }
      ]
    },
    {
      "id": "controller",
      "type": "sysml.Block",
      "label": "Controller",
      "members": [
        {
          "id": "controller.setAssistLevel",
          "type": "uml.Operation",
          "label": "setAssistLevel",
          "props": { "parameters": [{ "name": "level", "valueType": "Integer" }] }
        },
        { "id": "controller.supply", "type": "sysml.Port", "label": "supply" },
        { "id": "controller.drive", "type": "sysml.Port", "label": "drive" },
        { "id": "controller.lights", "type": "sysml.Port", "label": "lights" },
        { "id": "controller.bus", "type": "sysml.Port", "label": "bus" }
      ]
    },
    {
      "id": "dock",
      "type": "sysml.Block",
      "label": "Dock",
      "members": [
        { "id": "dock.charge", "type": "sysml.Port", "label": "charge", "props": { "valueType": "~ChargeInterface" } }
      ]
    },
    { "id": "range-ride", "type": "sysml.TestCase", "label": "Range ride on the test circuit" },
    { "id": "roller-test", "type": "sysml.TestCase", "label": "Cut-off speed on the rollers" },
    {
      "id": "why-500",
      "type": "uml.Comment",
      "label": "60 km at 7 Wh/km takes 420 Wh; 500 Wh keeps 15 % in reserve",
      "props": { "stereotypes": ["rationale"] }
    },
    { "id": "rental-vehicle", "type": "sysml.Block", "label": "RentalVehicle" },
    {
      "id": "emoped",
      "type": "sysml.Block",
      "label": "EMoped",
      "opensView": "inside-emoped",
      "members": [
        {
          "id": "emoped.battery",
          "type": "sysml.PartProperty",
          "label": "battery",
          "props": { "valueType": "Battery", "multiplicity": "1" }
        },
        {
          "id": "emoped.controller",
          "type": "sysml.PartProperty",
          "label": "controller",
          "props": { "valueType": "Controller", "multiplicity": "1" }
        },
        {
          "id": "emoped.motor",
          "type": "sysml.PartProperty",
          "label": "motor",
          "props": { "valueType": "Motor", "multiplicity": "1" }
        },
        {
          "id": "emoped.frontLight",
          "type": "sysml.PartProperty",
          "label": "frontLight",
          "props": { "valueType": "Light", "multiplicity": "1" }
        },
        {
          "id": "emoped.rearLight",
          "type": "sysml.PartProperty",
          "label": "rearLight",
          "props": { "valueType": "Light", "multiplicity": "1" }
        },
        {
          "id": "emoped.dock",
          "type": "sysml.ReferenceProperty",
          "label": "dock",
          "props": { "valueType": "Dock", "multiplicity": "0..1" }
        },
        {
          "id": "emoped.batteryCapacity",
          "type": "sysml.ValueProperty",
          "label": "batteryCapacity",
          "props": { "valueType": "Energy" }
        },
        {
          "id": "emoped.usableShare",
          "type": "sysml.ValueProperty",
          "label": "usableShare",
          "props": { "valueType": "Real" }
        },
        {
          "id": "emoped.ecoConsumption",
          "type": "sysml.ValueProperty",
          "label": "ecoConsumption",
          "props": { "valueType": "EnergyPerDistance" }
        },
        {
          "id": "emoped.boostConsumption",
          "type": "sysml.ValueProperty",
          "label": "boostConsumption",
          "props": { "valueType": "EnergyPerDistance" }
        },
        {
          "id": "emoped.ecoRange",
          "type": "sysml.ValueProperty",
          "label": "ecoRange",
          "props": { "valueType": "Distance" }
        },
        {
          "id": "emoped.boostRange",
          "type": "sysml.ValueProperty",
          "label": "boostRange",
          "props": { "valueType": "Distance" }
        },
        {
          "id": "emoped.usable",
          "type": "sysml.ConstraintProperty",
          "label": "usable",
          "props": { "valueType": "UsableEnergy" }
        },
        {
          "id": "emoped.eco",
          "type": "sysml.ConstraintProperty",
          "label": "eco",
          "props": { "valueType": "RangeEquation" }
        },
        {
          "id": "emoped.boost",
          "type": "sysml.ConstraintProperty",
          "label": "boost",
          "props": { "valueType": "RangeEquation" }
        }
      ]
    },
    {
      "id": "motor",
      "type": "sysml.Block",
      "label": "Motor",
      "members": [
        {
          "id": "motor.ratedPower",
          "type": "sysml.ValueProperty",
          "label": "ratedPower",
          "props": { "valueType": "Power" }
        },
        { "id": "motor.phases", "type": "sysml.Port", "label": "phases" }
      ]
    },
    {
      "id": "light",
      "type": "sysml.Block",
      "label": "Light",
      "members": [{ "id": "light.power", "type": "sysml.Port", "label": "power" }]
    },
    {
      "id": "charge-interface",
      "type": "sysml.InterfaceBlock",
      "label": "ChargeInterface",
      "members": [
        {
          "id": "charge-interface.dc",
          "type": "sysml.FlowProperty",
          "label": "dc",
          "props": { "valueType": "DCPower", "direction": "in" }
        },
        {
          "id": "charge-interface.stateOfCharge",
          "type": "sysml.FlowProperty",
          "label": "stateOfCharge",
          "props": { "valueType": "Percent", "direction": "out" }
        }
      ]
    },
    {
      "id": "usable-energy",
      "type": "sysml.ConstraintBlock",
      "label": "UsableEnergy",
      "props": { "constraint": "usable = capacity * share" },
      "members": [
        {
          "id": "usable-energy.usable",
          "type": "sysml.ConstraintParameter",
          "label": "usable",
          "props": { "valueType": "Energy" }
        },
        {
          "id": "usable-energy.capacity",
          "type": "sysml.ConstraintParameter",
          "label": "capacity",
          "props": { "valueType": "Energy" }
        },
        {
          "id": "usable-energy.share",
          "type": "sysml.ConstraintParameter",
          "label": "share",
          "props": { "valueType": "Real" }
        }
      ]
    },
    {
      "id": "range-equation",
      "type": "sysml.ConstraintBlock",
      "label": "RangeEquation",
      "props": { "constraint": "range = energy / consumption" },
      "members": [
        {
          "id": "range-equation.range",
          "type": "sysml.ConstraintParameter",
          "label": "range",
          "props": { "valueType": "Distance" }
        },
        {
          "id": "range-equation.energy",
          "type": "sysml.ConstraintParameter",
          "label": "energy",
          "props": { "valueType": "Energy" }
        },
        {
          "id": "range-equation.consumption",
          "type": "sysml.ConstraintParameter",
          "label": "consumption",
          "props": { "valueType": "EnergyPerDistance" }
        }
      ]
    },
    {
      "id": "voltage",
      "type": "sysml.ValueType",
      "label": "Voltage",
      "props": { "unit": "V", "quantityKind": "voltage" }
    },
    {
      "id": "energy",
      "type": "sysml.ValueType",
      "label": "Energy",
      "props": { "unit": "Wh", "quantityKind": "energy" }
    }
  ],
  "edges": [
    { "id": "capacity-from-range", "type": "sysml.DeriveReqt", "from": "capacity", "to": "range" },
    { "id": "curve-refines-assist", "type": "sysml.Refine", "from": "assist-curve", "to": "assist" },
    { "id": "range-traces-availability", "type": "sysml.Trace", "from": "range", "to": "availability" },
    { "id": "cut-off-copies-legal-speed", "type": "sysml.Copy", "from": "cut-off", "to": "legal-speed" },
    { "id": "battery-satisfies-capacity", "type": "sysml.Satisfy", "from": "battery", "to": "capacity" },
    { "id": "controller-satisfies-cut-off", "type": "sysml.Satisfy", "from": "controller", "to": "cut-off" },
    { "id": "dock-satisfies-lock-time", "type": "sysml.Satisfy", "from": "dock", "to": "lock-time" },
    { "id": "ride-verifies-range", "type": "sysml.Verify", "from": "range-ride", "to": "range" },
    { "id": "rollers-verify-cut-off", "type": "sysml.Verify", "from": "roller-test", "to": "cut-off" },
    { "id": "why-500-link", "type": "uml.CommentLink", "from": "why-500", "to": "capacity" },
    {
      "id": "emoped-battery",
      "type": "uml.Association",
      "from": "emoped",
      "to": "battery",
      "props": {
        "ends": {
          "from": { "aggregation": "composite", "multiplicity": "1" },
          "to": { "role": "battery", "multiplicity": "1" }
        }
      }
    },
    {
      "id": "emoped-motor",
      "type": "uml.Association",
      "from": "emoped",
      "to": "motor",
      "props": {
        "ends": {
          "from": { "aggregation": "composite", "multiplicity": "1" },
          "to": { "role": "motor", "multiplicity": "1" }
        }
      }
    },
    {
      "id": "emoped-controller",
      "type": "uml.Association",
      "from": "emoped",
      "to": "controller",
      "props": {
        "ends": {
          "from": { "aggregation": "composite", "multiplicity": "1" },
          "to": { "role": "controller", "multiplicity": "1" }
        }
      }
    },
    { "id": "emoped-is-rental-vehicle", "type": "uml.Generalization", "from": "emoped", "to": "rental-vehicle" },
    {
      "id": "dock-uses-charge-interface",
      "type": "uml.Dependency",
      "from": "dock",
      "to": "charge-interface",
      "props": { "stereotypes": ["use"] }
    },
    {
      "id": "battery-dock-charge",
      "type": "sysml.Connector",
      "from": "battery.charge",
      "to": "dock.charge",
      "props": {
        "ends": { "from": { "part": "emoped.battery" }, "to": { "part": "emoped.dock" } },
        "itemFlow": { "item": "DCPower", "direction": "to-from" }
      }
    },
    {
      "id": "battery-feeds-controller",
      "type": "sysml.Connector",
      "from": "battery.power",
      "to": "controller.supply",
      "props": {
        "ends": { "from": { "part": "emoped.battery" }, "to": { "part": "emoped.controller" } },
        "itemFlow": { "item": "DCPower", "direction": "from-to" }
      }
    },
    {
      "id": "controller-drives-motor",
      "type": "sysml.Connector",
      "from": "controller.drive",
      "to": "motor.phases",
      "props": {
        "ends": { "from": { "part": "emoped.controller" }, "to": { "part": "emoped.motor" } },
        "itemFlow": { "item": "PhaseCurrent", "direction": "from-to" }
      }
    },
    {
      "id": "battery-controller-bus",
      "type": "sysml.Connector",
      "from": "battery.bus",
      "to": "controller.bus",
      "props": { "ends": { "from": { "part": "emoped.battery" }, "to": { "part": "emoped.controller" } } }
    },
    {
      "id": "controller-front-light",
      "type": "sysml.Connector",
      "from": "controller.lights",
      "to": "light.power",
      "props": { "ends": { "from": { "part": "emoped.controller" }, "to": { "part": "emoped.frontLight" } } }
    },
    {
      "id": "controller-rear-light",
      "type": "sysml.Connector",
      "from": "controller.lights",
      "to": "light.power",
      "props": { "ends": { "from": { "part": "emoped.controller" }, "to": { "part": "emoped.rearLight" } } }
    },
    {
      "id": "bind-capacity",
      "type": "sysml.BindingConnector",
      "from": "emoped.batteryCapacity",
      "to": "usable-energy.capacity",
      "props": { "ends": { "to": { "part": "emoped.usable" } } }
    },
    {
      "id": "bind-share",
      "type": "sysml.BindingConnector",
      "from": "emoped.usableShare",
      "to": "usable-energy.share",
      "props": { "ends": { "to": { "part": "emoped.usable" } } }
    },
    {
      "id": "bind-usable-eco",
      "type": "sysml.BindingConnector",
      "from": "usable-energy.usable",
      "to": "range-equation.energy",
      "props": { "ends": { "from": { "part": "emoped.usable" }, "to": { "part": "emoped.eco" } } }
    },
    {
      "id": "bind-usable-boost",
      "type": "sysml.BindingConnector",
      "from": "usable-energy.usable",
      "to": "range-equation.energy",
      "props": { "ends": { "from": { "part": "emoped.usable" }, "to": { "part": "emoped.boost" } } }
    },
    {
      "id": "bind-eco-consumption",
      "type": "sysml.BindingConnector",
      "from": "emoped.ecoConsumption",
      "to": "range-equation.consumption",
      "props": { "ends": { "to": { "part": "emoped.eco" } } }
    },
    {
      "id": "bind-boost-consumption",
      "type": "sysml.BindingConnector",
      "from": "emoped.boostConsumption",
      "to": "range-equation.consumption",
      "props": { "ends": { "to": { "part": "emoped.boost" } } }
    },
    {
      "id": "bind-eco-range",
      "type": "sysml.BindingConnector",
      "from": "emoped.ecoRange",
      "to": "range-equation.range",
      "props": { "ends": { "to": { "part": "emoped.eco" } } }
    },
    {
      "id": "bind-boost-range",
      "type": "sysml.BindingConnector",
      "from": "emoped.boostRange",
      "to": "range-equation.range",
      "props": { "ends": { "to": { "part": "emoped.boost" } } }
    }
  ],
