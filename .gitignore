.DS_Store
__pycache__/
*.pyc
# check screenshots written by render
.*-check/
# temporary model copy written by render
.*.icons.json
# local worktrees of agents and tools
.claude/worktrees/
node_modules/
docs/.vitepress/dist/
docs/.vitepress/cache/
# the type pages rendered from examples/types/*.json (each the whole module): CI's site job builds them
examples/types/*.html
# local scratch: browser automation logs and snapshots, the agents' own folder, throwaway JSON at the root
.playwright-mcp/
/.claude/
/k.json
/k.out.json

# the integration fixture's standalone page: tests/embed.py renders it from tests/fixtures/integration.json before the browser pages
tests/fixtures/integration.html
# the page with a docs link tests/embed.py writes with umlimator.py render --docs, for tests/docs-frame.html too
tests/fixtures/docs-link.html
# the time-lapse page tests/embed.py writes with umlimator.py timelapse for tests/timelapse.html
tests/fixtures/timelapse.html
# the self-evolving loop's local state (tools/evolve/): the ownership lease, its lock and the fuzz run's findings
/.evolve/lease.json
/.evolve/lease.json.lock/
/.evolve/fuzz/
