          "id": "m2",
          "type": "uml.Message",
          "from": "lifeline-app",
          "to": "lifeline-api",
          "label": "start(ride)",
          "props": { "sort": "call" }
        },
        {
          "id": "m3",
          "type": "uml.Message",
          "from": "lifeline-api",
          "to": "lifeline-api",
          "label": "check(pass)",
          "props": { "sort": "call" }
        },
        {
          "id": "m4",
          "type": "uml.Message",
          "from": "lifeline-api",
          "to": "lifeline-dock",
          "label": "release(bike)",
          "props": { "sort": "call" }
        },
        {
          "id": "m5",
          "type": "uml.Message",
          "from": "lifeline-dock",
