          "parent": "f1-paid",
          "label": "released",
          "props": { "sort": "reply", "replyTo": "m4" }
        },
        {
          "id": "m6",
          "type": "uml.Message",
          "from": "lifeline-api",
          "to": "receipt",
          "parent": "f1-paid",
