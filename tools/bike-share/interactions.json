        },
        {
          "id": "mail-2",
          "type": "uml.Message",
          "from": "email",
          "to": "lifeline-rider",
          "label": "ride notice",
          "props": { "sort": "async" }
        }
      ]
    },
    {
      "id": "log-ride",
      "diagram": "uml.sequence",
      "parent": "hire-overview",
      "title": "Log the ride",
      "nodeIds": ["lifeline-api", "lifeline-queue", "lifeline-worker"],
      "edges": [
        {
          "id": "queue-1",
          "type": "uml.Message",
          "from": "lifeline-api",
