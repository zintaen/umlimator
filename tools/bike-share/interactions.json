{
  "nodes": [
    {
      "id": "lifeline-rider",
      "type": "uml.Lifeline",
      "label": "rider",
      "props": { "represents": "Rider", "stereotypes": ["actor"] }
    },
    { "id": "lifeline-app", "type": "uml.Lifeline", "label": "app", "props": { "represents": "RiderApp" } },
    { "id": "lifeline-api", "type": "uml.Lifeline", "label": "api", "props": { "represents": "TripApi" } },
    {
      "id": "lifeline-dock",
      "type": "uml.Lifeline",
      "label": "dock",
      "props": { "represents": "Dock", "states": ["Idle", "Checking the bike", "Unlatching"] }
    },
    { "id": "receipt", "type": "uml.Lifeline", "label": "ride", "props": { "represents": "RideRecord" } },
    { "id": "buy-start", "type": "uml.InitialNode" },
    { "id": "ref-find", "type": "uml.InteractionUse", "label": "Find a bike", "opensView": "locate-bike" },
    { "id": "try-payment", "type": "uml.MergeNode" },
    { "id": "ref-hire", "type": "uml.InteractionUse", "label": "Unlock", "opensView": "hire-unlock" },
    { "id": "payment-ok", "type": "uml.DecisionNode", "label": "Bike released?" },
    { "id": "buy-split", "type": "uml.ForkNode" },
    { "id": "ref-receipt", "type": "uml.InteractionUse", "label": "Send the ride notice", "opensView": "ride-notice" },
    { "id": "sd-queue", "type": "uml.Interaction", "label": "Log the ride", "opensView": "log-ride" },
    { "id": "both-done", "type": "uml.JoinNode" },
    { "id": "buy-done", "type": "uml.ActivityFinalNode" },
    { "id": "email", "type": "uml.Lifeline", "label": "email", "props": { "represents": "EmailService" } },
    { "id": "lifeline-queue", "type": "uml.Lifeline", "label": "queue", "props": { "represents": "RideQueue" } },
    {
      "id": "lifeline-worker",
      "type": "uml.Lifeline",
      "label": "worker",
      "props": { "represents": "RideWorker", "states": ["Idle", "Waiting for the dock", "Recording the release"] }
    }
  ],
  "edges": [
    { "id": "rider-to-app", "type": "uml.Connector", "from": "lifeline-rider", "to": "lifeline-app" },
    { "id": "app-api", "type": "uml.Connector", "from": "lifeline-app", "to": "lifeline-api" },
    { "id": "api-self", "type": "uml.Connector", "from": "lifeline-api", "to": "lifeline-api" },
    { "id": "api-dock", "type": "uml.Connector", "from": "lifeline-api", "to": "lifeline-dock" },
    { "id": "api-ride", "type": "uml.Connector", "from": "lifeline-api", "to": "receipt" },
    {
      "id": "cm1",
      "type": "uml.Message",
      "from": "lifeline-rider",
      "to": "lifeline-app",
      "label": "unlock()",
      "props": { "sort": "call" }
    },
    {
      "id": "cm2",
      "type": "uml.Message",
      "from": "lifeline-app",
      "to": "lifeline-api",
      "label": "start(ride)",
      "props": { "sort": "call" }
    },
    {
      "id": "cm3",
      "type": "uml.Message",
      "from": "lifeline-api",
      "to": "lifeline-api",
      "label": "check(pass)",
      "props": { "sort": "call" }
    },
    {
      "id": "cm4",
      "type": "uml.Message",
      "from": "lifeline-api",
      "to": "lifeline-dock",
      "label": "release(bike)",
      "props": { "sort": "call" }
    },
    {
      "id": "cm5",
      "type": "uml.Message",
      "from": "lifeline-dock",
      "to": "lifeline-api",
      "label": "released",
      "props": { "sort": "reply", "replyTo": "cm4" }
    },
    {
      "id": "cm6",
      "type": "uml.Message",
      "from": "lifeline-api",
      "to": "receipt",
      "label": "new(ride)",
      "props": { "sort": "create" }
    },
    {
      "id": "cm7",
      "type": "uml.Message",
      "from": "lifeline-api",
      "to": "lifeline-app",
      "label": "rideStarted",
      "props": { "sort": "async" }
    },
    {
      "id": "cm8",
      "type": "uml.Message",
      "from": "lifeline-api",
      "to": "lifeline-app",
      "label": "result",
      "props": { "sort": "reply", "replyTo": "cm2" }
    },
    {
      "id": "cm9",
      "type": "uml.Message",
      "from": "lifeline-app",
      "to": "lifeline-rider",
      "label": "ride started screen",
      "props": { "sort": "reply", "replyTo": "cm1" }
    },
    { "id": "f-buy-start", "type": "uml.ControlFlow", "from": "buy-start", "to": "ref-find" },
    { "id": "f-found", "type": "uml.ControlFlow", "from": "ref-find", "to": "try-payment" },
    { "id": "f-pay", "type": "uml.ControlFlow", "from": "try-payment", "to": "ref-hire" },
    { "id": "f-result", "type": "uml.ControlFlow", "from": "ref-hire", "to": "payment-ok" },
    {
      "id": "f-accepted",
      "type": "uml.ControlFlow",
      "from": "payment-ok",
      "to": "buy-split",
      "props": { "guard": "bike released" }
    },
    {
      "id": "f-declined",
      "type": "uml.ControlFlow",
      "from": "payment-ok",
      "to": "try-payment",
      "props": { "guard": "else" }
    },
    { "id": "f-to-receipt", "type": "uml.ControlFlow", "from": "buy-split", "to": "ref-receipt" },
    { "id": "f-to-queue", "type": "uml.ControlFlow", "from": "buy-split", "to": "sd-queue" },
    { "id": "f-receipt-sent", "type": "uml.ControlFlow", "from": "ref-receipt", "to": "both-done" },
    { "id": "f-queued", "type": "uml.ControlFlow", "from": "sd-queue", "to": "both-done" },
    { "id": "f-buy-done", "type": "uml.ControlFlow", "from": "both-done", "to": "buy-done" }
  ],
  "views": [
    {
