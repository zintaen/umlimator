          "type": "uml.CombinedFragment",
          "props": { "operator": "alt" },
          "members": [
            { "id": "f1-paid", "type": "uml.InteractionOperand", "label": "bike released" },
            { "id": "f1-declined", "type": "uml.InteractionOperand", "label": "else" }
          ]
        },
        {
          "id": "sq-f2",
          "type": "uml.CombinedFragment",
          "parent": "f1-paid",
          "props": { "operator": "opt" },
          "members": [{ "id": "f2-notify", "type": "uml.InteractionOperand", "label": "rider is still at the dock" }]
        }
      ]
    },
    {
      "id": "unlock-communication",
      "diagram": "uml.communication",
      "parent": null,
      "title": "Unlocking: bike released",
      "nodeIds": ["lifeline-rider", "lifeline-app", "lifeline-api", "lifeline-dock", "receipt"],
      "edges": [
        "rider-to-app", "app-api", "api-self", "api-dock", "api-ride", "cm1", "cm2", "cm3", "cm4", "cm5", "cm6", "cm7",
        "cm8", "cm9"
      ]
    },
    {
