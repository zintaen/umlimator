        },
        {
          "id": "queue-3",
          "type": "uml.Message",
          "from": "lifeline-queue",
          "to": "lifeline-worker",
          "label": "rideStarted",
          "props": { "sort": "async" }
        }
      ]
    },
    {
      "id": "dock-latch",
      "diagram": "uml.timing",
      "parent": null,
      "title": "One latch release",
      "nodeIds": ["lifeline-worker", "lifeline-dock"],
      "edges": [
        {
          "id": "m-charge",
          "type": "uml.Message",
          "from": "lifeline-worker",
          "to": "lifeline-dock",
          "label": "release(bike)",
          "props": { "sort": "call", "sentAt": 100, "receivedAt": 140 }
        },
        {
          "id": "m-paid",
          "type": "uml.Message",
          "from": "lifeline-dock",
          "to": "lifeline-worker",
          "label": "released",
          "props": { "sort": "reply", "replyTo": "m-charge", "sentAt": 720, "receivedAt": 760 }
        }
      ],
      "timeline": {
        "unit": "ms",
        "changes": [
          { "id": "w-idle", "lifeline": "lifeline-worker", "at": 0, "state": "Idle" },
          { "id": "w-waiting", "lifeline": "lifeline-worker", "at": 100, "state": "Waiting for the dock" },
          { "id": "w-recording", "lifeline": "lifeline-worker", "at": 760, "state": "Recording the release" },
          { "id": "w-done", "lifeline": "lifeline-worker", "at": 900, "state": "Idle" },
          { "id": "p-idle", "lifeline": "lifeline-dock", "at": 0, "state": "Idle" },
          { "id": "p-authorising", "lifeline": "lifeline-dock", "at": 140, "state": "Checking the bike" },
          { "id": "p-capturing", "lifeline": "lifeline-dock", "at": 480, "state": "Unlatching" },
          { "id": "p-done", "lifeline": "lifeline-dock", "at": 720, "state": "Idle" }
        ],
        "constraints": [
          {
            "id": "c-wait",
            "type": "uml.DurationConstraint",
            "from": "w-waiting",
            "to": "w-recording",
            "label": "{<= 800 ms}"
          },
          { "id": "c-finished", "type": "uml.TimeConstraint", "from": "w-done", "label": "{<= 1000 ms}" }
        ]
      }
    }
  ]
}
