{
  "nodes": [
    {
      "id": "c4-rider",
      "type": "c4.Person",
      "label": "Rider",
      "opensView": "rider-uses",
      "props": { "description": "Finds and hires bikes, pays for rides and reports faults." }
    },
    {
      "id": "c4-staff",
      "type": "c4.Person",
      "label": "Operations staff",
      "opensView": "triage",
      "props": { "description": "Keep the fleet in service and refund rides." }
    },
    {
      "id": "c4-bikeshare",
      "type": "c4.SoftwareSystem",
      "label": "Bike share",
      "opensView": "c4-containers",
      "props": { "description": "Hires e-bikes from city docks: finding, unlocking, pricing and paying for rides." }
    },
    {
      "id": "c4-payments",
      "type": "c4.SoftwareSystem",
      "label": "Payment provider",
      "props": { "description": "Takes card payments and makes refunds.", "external": true }
    },
    {
      "id": "c4-mail",
      "type": "c4.SoftwareSystem",
      "label": "Email service",
      "props": { "description": "Delivers the operator's emails.", "external": true }
    },
    {
      "id": "c4-van",
      "type": "c4.SoftwareSystem",
      "label": "Van service",
      "props": { "description": "Collects faulty bikes and brings them back repaired.", "external": true }
    },
    {
      "id": "c4-app",
      "type": "c4.Container",
      "label": "Rider app",
      "parent": "c4-bikeshare",
      "opensView": "rider-data",
      "props": {
        "technology": "TypeScript, React",
        "description": "The rider's app: a map of bikes, unlock and ride history, and the admin pages for staff."
      }
    },
    {
      "id": "c4-api",
      "type": "c4.Container",
      "label": "Trip API",
      "parent": "c4-bikeshare",
      "opensView": "c4-components",
      "props": { "technology": "Python, FastAPI", "description": "Bikes, rides, pricing and accounts as a JSON API." }
    },
    {
      "id": "c4-worker",
      "type": "c4.Container",
      "label": "Ride worker",
      "parent": "c4-bikeshare",
      "opensView": "log-ride",
      "props": {
        "technology": "Python",
        "description": "Closes ended rides: books a van for a faulty bike and sends the receipt."
      }
    },
    {
      "id": "c4-db",
      "type": "c4.Container",
      "label": "Database",
      "parent": "c4-bikeshare",
      "opensView": "trips-schema",
      "props": { "technology": "PostgreSQL", "description": "Bikes, docks, rides and accounts." }
    },
    {
      "id": "c4-queue",
      "type": "c4.Container",
      "label": "Ride queue",
      "parent": "c4-bikeshare",
      "props": { "technology": "PostgreSQL table", "description": "Ended rides waiting to be closed, oldest first." }
    },
    {
      "id": "c4-finder",
      "type": "c4.Component",
      "label": "Bike finder",
      "parent": "c4-api",
      "opensView": "packages",
      "props": { "technology": "FastAPI router", "description": "Lists and searches free bikes and docks." }
    },
    {
      "id": "c4-hire",
      "type": "c4.Component",
      "label": "Hire",
      "parent": "c4-api",
      "opensView": "unlock-communication",
      "props": { "technology": "FastAPI router", "description": "Turns an unlock into a paid ride." }
    },
    {
      "id": "c4-accounts",
      "type": "c4.Component",
      "label": "Accounts and sign-in",
      "parent": "c4-api",
      "props": {
        "technology": "FastAPI router",
        "description": "Signs riders and staff in; keeps hashed passwords and sessions."
      }
    },
    {
      "id": "c4-payment-client",
      "type": "c4.Component",
      "label": "Payment client",
      "parent": "c4-api",
      "props": { "technology": "Python, httpx", "description": "Starts card payments and reads their result." }
    },
    {
      "id": "c4-ride-store",
      "type": "c4.Component",
      "label": "Ride store",
      "parent": "c4-api",
      "opensView": "dfd-0",
      "props": { "technology": "SQLAlchemy", "description": "Saves rides and puts the ended ones on the ride queue." }
    },
    {
      "id": "c4-device",
