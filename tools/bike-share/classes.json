  "edges": [
    {
      "id": "rider-rides",
      "type": "uml.Association",
      "from": "rider",
      "to": "ride",
      "label": "takes",
      "props": {
        "ends": {
          "from": { "multiplicity": "1" },
          "to": { "role": "rides", "multiplicity": "0..*", "navigable": true }
        }
      }
    },
    {
      "id": "ride-legs",
      "type": "uml.Association",
      "from": "ride",
      "to": "leg",
      "props": {
        "ends": {
          "from": { "aggregation": "composite", "multiplicity": "1" },
          "to": { "role": "legs", "multiplicity": "1..*", "navigable": true }
        }
      }
    },
    {
      "id": "leg-bike",
      "type": "uml.Association",
      "from": "leg",
      "to": "bike",
      "props": {
        "ends": { "from": { "multiplicity": "0..*" }, "to": { "role": "bike", "multiplicity": "1", "navigable": true } }
      }
    },
    {
      "id": "ride-payment",
      "type": "uml.Association",
      "from": "ride",
      "to": "payment",
      "props": {
        "ends": {
          "from": { "aggregation": "shared", "multiplicity": "1" },
          "to": { "role": "payments", "multiplicity": "0..*" }
