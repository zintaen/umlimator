    {
      "id": "rider",
      "type": "uml.Class",
      "label": "Rider",
      "parent": "rides-package",
      "opensView": "ride-snapshot",
      "members": [
        {
          "id": "rider.email",
          "type": "uml.Property",
          "label": "email",
          "props": { "visibility": "private", "valueType": "String" }
        },
        {
          "id": "rider.name",
          "type": "uml.Property",
          "label": "name",
          "props": { "visibility": "private", "valueType": "String", "multiplicity": "0..1" }
        }
      ]
    },
    {
      "id": "ride",
      "type": "uml.Class",
      "label": "Ride",
      "parent": "rides-package",
      "opensView": "ride-life",
      "props": {
        "stereotypes": ["entity"],
        "tags": { "entity": { "table": "rides" }, "personalData": { "retention": "2 years" } }
      },
      "members": [
        {
          "id": "ride.id",
          "type": "uml.Property",
          "label": "id",
          "props": { "visibility": "private", "valueType": "UUID" }
        },
        {
          "id": "ride.startedAt",
          "type": "uml.Property",
          "label": "startedAt",
          "props": {
            "visibility": "private",
            "valueType": "Instant",
            "multiplicity": "0..1",
            "stereotypes": ["column"],
            "tags": { "column": { "name": "started_at", "indexed": "true" } }
          }
        },
        {
          "id": "ride.status",
          "type": "uml.Property",
          "label": "status",
          "props": { "visibility": "private", "valueType": "RideStatus", "default": "booked" }
