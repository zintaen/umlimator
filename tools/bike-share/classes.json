        {
          "id": "ride.total",
          "type": "uml.Property",
          "label": "total",
          "props": { "visibility": "public", "valueType": "Money", "isDerived": true }
        },
        {
          "id": "ride.count",
          "type": "uml.Property",
          "label": "count",
          "props": { "visibility": "public", "valueType": "Integer", "isStatic": true }
        },
        {
          "id": "ride.start",
          "type": "uml.Operation",
          "label": "start",
          "props": { "visibility": "public", "returnType": "Receipt" }
        },
        {
          "id": "ride.add",
          "type": "uml.Operation",
          "label": "add",
          "props": {
            "visibility": "public",
            "parameters": [{ "name": "bike", "valueType": "Bike" }, { "name": "minutes", "valueType": "Integer" }]
          }
        },
        { "id": "ride.cancel", "type": "uml.Operation", "label": "cancel", "props": { "visibility": "public" } }
      ]
    },
    {
      "id": "leg",
