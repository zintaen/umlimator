        {
          "id": "leg.ratePerMinute",
          "type": "uml.Property",
          "label": "ratePerMinute",
          "props": { "visibility": "private", "valueType": "Money" }
        }
      ]
    },
    {
      "id": "bike",
      "type": "uml.Class",
      "label": "Bike",
