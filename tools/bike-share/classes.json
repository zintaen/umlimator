{
  "nodes": [
    { "id": "rides-package", "type": "uml.Package", "label": "rides", "opensView": "domain" },
    { "id": "shared", "type": "uml.Package", "label": "shared" },
    { "id": "fleet-package", "type": "uml.Package", "label": "fleet" },
    { "id": "payments-package", "type": "uml.Package", "label": "payments" },
